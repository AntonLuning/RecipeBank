package pages

import (
	"github.com/AntonLuning/RecipeBank/pkg/core/models"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/card"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/pagination"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/button"
)

// IndexPageData contains all data needed for the index page template
type IndexPageData struct {
	RecipePage  *models.RecipePage
	Error       string
	SearchQuery map[string][]string
}

// IndexPage is the main templ component for the recipe index page
templ IndexPage(data IndexPageData) {
	@BaseLayout("Recipe Bank - All Recipes") {
		@RecipeHeader()
		@RecipeFilters(data.SearchQuery)
		if data.Error != "" {
			@ErrorState(data.Error)
		} else {
			@RecipeGrid(data.RecipePage.Recipes)
			if data.RecipePage != nil && data.RecipePage.TotalPages > 1 {
				@RecipePagination(data.RecipePage)
			}
		}
	}
}

// RecipeHeader renders the page header section
templ RecipeHeader() {
	<div class="mb-8">
		<h1 class="text-4xl font-bold text-foreground mb-2">Recipe Collection</h1>
		<p class="text-muted-foreground">Discover and explore our delicious recipes</p>
	</div>
}

// RecipeFilters renders the search and filter section
templ RecipeFilters(searchQuery map[string][]string) {
	@card.Card(card.Props{Class: "mb-8"}) {
		@card.Content() {
			<form method="GET" action="/">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
					<div>
						<label for="title" class="block text-sm font-medium text-foreground mb-2">Search Recipes</label>
						<input 
							id="title"
							name="title"
							type="text" 
							value={ getQueryValue(searchQuery, "title") }
							placeholder="Search by title..."
							class="w-full px-3 py-2 border border-border rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
						>
					</div>
					<div>
						<label for="cook_time" class="block text-sm font-medium text-foreground mb-2">Max Cook Time (min)</label>
						<input 
							id="cook_time"
							name="cook_time"
							type="number" 
							value={ getQueryValue(searchQuery, "cook_time") }
							placeholder="e.g. 30"
							class="w-full px-3 py-2 border border-border rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
						>
					</div>
					<div>
						<label for="tags" class="block text-sm font-medium text-foreground mb-2">Tags</label>
						<input 
							id="tags"
							name="tags"
							type="text" 
							value={ getQueryValue(searchQuery, "tags") }
							placeholder="e.g. dessert,cookies"
							class="w-full px-3 py-2 border border-border rounded-md bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
						>
					</div>
					<div class="flex items-end">
						@button.Button(button.Props{
							Type: "submit",
							Class: "w-full",
						}) {
							Search
						}
					</div>
				</div>
			</form>
		}
	}
}

// RecipeGrid renders the main recipe grid with cards
templ RecipeGrid(recipes []models.Recipe) {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
		if len(recipes) == 0 {
			<div class="col-span-full text-center py-8">
				<div class="text-muted-foreground mb-4">
					<svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
					</svg>
				</div>
				<p class="text-muted-foreground">No recipes found. Try adjusting your search criteria.</p>
			</div>
		} else {
			for _, recipe := range recipes {
				@RecipeCard(recipe)
			}
		}
	</div>
}

// RecipeCard renders a single recipe card using templUI Card component
templ RecipeCard(recipe models.Recipe) {
	@card.Card(card.Props{Class: "hover:shadow-lg transition-shadow duration-300"}) {
		<div class="aspect-w-16 aspect-h-9">
			<img 
				src={ getRecipeImageSrc(recipe.Image) }
				alt={ recipe.Title }
				class="w-full h-48 object-cover rounded-t-lg"
				loading="lazy"
				onerror="this.onerror=null; this.src='data:image/svg+xml;base64,'"
			>
		</div>
		@card.Header() {
			@card.Title() {
				{ recipe.Title }
			}
			@card.Description() {
				{ recipe.Description }
			}
		}
		@card.Content(card.ContentProps{Class: "pt-0"}) {
			<div class="flex items-center justify-between text-xs text-muted-foreground mb-3">
				if recipe.CookTime > 0 {
					<span class="flex items-center">
						<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						{ formatCookTime(recipe.CookTime) }
					</span>
				}
				if recipe.Servings > 0 {
					<span class="flex items-center">
						<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
						</svg>
						{ formatServings(recipe.Servings) }
					</span>
				}
			</div>
			
			if len(recipe.Tags) > 0 {
				<div class="flex flex-wrap gap-1 mb-3">
					for i, tag := range recipe.Tags {
						if i < 3 {
							<span class="px-2 py-1 bg-secondary text-secondary-foreground text-xs rounded-full">{ tag }</span>
						}
					}
					if len(recipe.Tags) > 3 {
						<span class="px-2 py-1 bg-muted text-muted-foreground text-xs rounded-full">
							+{ formatExtraTags(len(recipe.Tags) - 3) }
						</span>
					}
				</div>
			}
		}
		@card.Footer() {
			@button.Button(button.Props{
				Href: "/recipe/" + recipe.ID.Hex(),
				Class: "w-full",
			}) {
				View Recipe
			}
		}
	}
}

// ErrorState renders an error message
templ ErrorState(errorMsg string) {
	@card.Card(card.Props{Class: "text-center py-8"}) {
		@card.Content() {
			<div class="text-destructive mb-4">
				<svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
				</svg>
			</div>
			<p class="text-muted-foreground mb-4">{ errorMsg }</p>
			@button.Button(button.Props{Href: "/"}) {
				Try Again
			}
		}
	}
}

// RecipePagination renders pagination controls using templUI Pagination component
templ RecipePagination(recipePage *models.RecipePage) {
	@pagination.Pagination(pagination.Props{Class: "mt-8"}) {
		@pagination.Content() {
			if recipePage.Page > 1 {
				@pagination.Item() {
					@pagination.Previous(pagination.PreviousProps{
						Href:  "?page=" + formatPageNumber(recipePage.Page - 1),
						Label: "Previous",
					})
				}
			}
			
			for i := 1; i <= recipePage.TotalPages; i++ {
				if i == recipePage.Page {
					@pagination.Item() {
						@pagination.Link(pagination.LinkProps{
							IsActive: true,
						}) {
							{ formatPageNumber(i) }
						}
					}
				} else if shouldShowPage(i, recipePage.Page, recipePage.TotalPages) {
					@pagination.Item() {
						@pagination.Link(pagination.LinkProps{
							Href: "?page=" + formatPageNumber(i),
						}) {
							{ formatPageNumber(i) }
						}
					}
				}
			}
			
			if recipePage.Page < recipePage.TotalPages {
				@pagination.Item() {
					@pagination.Next(pagination.NextProps{
						Href:  "?page=" + formatPageNumber(recipePage.Page + 1),
						Label: "Next",
					})
				}
			}
		}
	}
}