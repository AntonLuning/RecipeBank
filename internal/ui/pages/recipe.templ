package pages

import (
	"fmt"
	"strconv"

	"github.com/AntonLuning/RecipeBank/pkg/models"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/card"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/button"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/badge"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/icon"
	"github.com/AntonLuning/RecipeBank/internal/ui/pages/components"
)

type RecipePageData struct {
	Recipe *models.Recipe
	Error  string
}

templ RecipePage(data RecipePageData) {
	@BaseLayout("Recipe Bank - " + getRecipeTitle(data.Recipe)) {
		if data.Error != "" {
			@recipeErrorState(data.Error)
		} else {
			@recipeDetail(data.Recipe)
		}
	}
}

templ recipeDetail(recipe *models.Recipe) {
	<div class="min-h-screen bg-background">
		<div class="max-w-6xl mx-auto px-4 py-12">
			@recipeHeader(recipe)

			<div class="mb-12">
				@card.Card(card.Props{Class: "overflow-hidden"}) {
					<img 
						src={ components.GetRecipeImageSrc(recipe.Image) }
						alt={ recipe.Title }
						class="w-full h-96 xl:h-[500px] object-cover"
						onerror="this.onerror=null; this.src='data:image/svg+xml;base64,'"
					>
				}
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
				@recipeIngredients(recipe)
				@recipeInstructions(recipe)
			</div>
		</div>
	</div>
}

templ recipeHeader(recipe *models.Recipe) {
	<div class="mb-12">
		@button.Button(button.Props{
			Href: "/",
			Class: "mb-8 group",
			Variant: "outline",
		}) {
			@icon.Icon("arrow-left")(icon.Props{Size: 16, Class: "mr-2 transition-transform group-hover:-translate-x-1"})
			Back to Recipes
		}
		
		<div class="space-y-6">
			<h1 class="text-5xl font-bold text-foreground leading-tight">{ recipe.Title }</h1>
			if recipe.Description != "" {
				<p class="text-xl text-muted-foreground max-w-4xl leading-relaxed">{ recipe.Description }</p>
			}
			
			<!-- Clean stats bar -->
			<div class="flex flex-wrap items-center gap-8 pt-6 border-b border-border pb-6">
				if recipe.CookTime > 0 {
					<div class="flex items-center gap-3 text-muted-foreground">
						@icon.Icon("clock")(icon.Props{Size: 20, Class: "text-primary"})
						<span class="font-medium">{ components.FormatCookTime(recipe.CookTime) }</span>
					</div>
				}
				if recipe.Servings > 0 {
					<div class="flex items-center gap-3 text-muted-foreground">
						@icon.Icon("users")(icon.Props{Size: 20, Class: "text-primary"})
						<span class="font-medium">{ components.FormatServings(recipe.Servings) }</span>
					</div>
				}
				if len(recipe.Tags) > 0 {
					<div class="flex items-center gap-3">
						@icon.Icon("tag")(icon.Props{Size: 20, Class: "text-primary"})
						<div class="flex flex-wrap gap-2">
							for _, tag := range recipe.Tags {
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "text-xs"}) {
									{ tag }
								}
							}
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

templ recipeIngredients(recipe *models.Recipe) {
	<div>
		@card.Card(card.Props{Class: "h-full"}) {
			@card.Header(card.HeaderProps{Class: "pb-2"}) {
				@card.Title(card.TitleProps{Class: "flex items-center gap-3 text-2xl font-bold"}) {
					@icon.Icon("shopping-cart")(icon.Props{Size: 24, Class: "text-primary"})
					Ingredients
					if len(recipe.Ingredients) > 0 {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto text-xs"}) {
							{ strconv.Itoa(len(recipe.Ingredients)) } items
						}
					}
				}
			}
			@card.Content() {
				if len(recipe.Ingredients) > 0 {
					<div>
						for _, ingredient := range recipe.Ingredients {
							<div class="grid grid-cols-[50px_1fr] gap-6 p-2 rounded-lg hover:bg-muted/50 transition-colors">
								<div class="text-left">
									if hasIngredientQuantity(ingredient) {
										<span class="inline-flex items-baseline gap-1">
											if ingredient.Quantity > 0 {
												<span class="font-semibold text-foreground">{ formatQuantityNumber(ingredient.Quantity) }</span>
											}
											if ingredient.Unit != "" {
												<span class="text-sm text-muted-foreground font-medium">{ ingredient.Unit }</span>
											}
										</span>
									} else {
										<span class="text-xs text-muted-foreground"></span>
									}
								</div>
								<div class="text-left">
									<span class="text-foreground leading-relaxed">{ formatIngredientName(ingredient) }</span>
								</div>
							</div>
						}
					</div>
				} else {
					<div class="text-center py-12 text-muted-foreground">
						@icon.Icon("package")(icon.Props{Size: 48, Class: "mx-auto mb-4 opacity-50"})
						<p>No ingredients listed.</p>
					</div>
				}
			}
		}
	</div>
}

templ recipeInstructions(recipe *models.Recipe) {
	<div>
		@card.Card(card.Props{Class: "h-full"}) {
			@card.Header(card.HeaderProps{Class: "pb-2"}) {
				@card.Title(card.TitleProps{Class: "flex items-center gap-3 text-2xl font-bold"}) {
					@icon.Icon("list-ordered")(icon.Props{Size: 22, Class: "text-primary"})
					Instructions
					if len(recipe.Steps) > 0 {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary, Class: "ml-auto text-xs"}) {
							{ strconv.Itoa(len(recipe.Steps)) } steps
						}
					}
				}
			}
			@card.Content() {
				if len(recipe.Steps) > 0 {
					<div class="space-y-2">
						for i, step := range recipe.Steps {
							<div class="flex items-baseline gap-4 p-3 rounded-lg hover:bg-muted/50 transition-colors">
								<div class="flex-shrink-0">
									<div class="w-8 h-8 border-2 border-primary text-primary rounded-full flex items-center justify-center text-sm font-bold">
										{ strconv.Itoa(i + 1) }
									</div>
								</div>
								<span class="text-foreground leading-relaxed">{ step }</span>
							</div>
						}
					</div>
				} else {
					<div class="text-center py-12 text-muted-foreground">
						@icon.Icon("clipboard-list")(icon.Props{Size: 48, Class: "mx-auto mb-4 opacity-50"})
						<p>No instructions provided.</p>
					</div>
				}
			}
		}
	</div>
}

templ recipeErrorState(errorMsg string) {
	<div class="min-h-screen bg-background flex items-center justify-center px-4">
		<div class="max-w-2xl w-full">
			@button.Button(button.Props{
				Href: "/",
				Class: "mb-6 group",
				Variant: "outline",
			}) {
				@icon.Icon("arrow-left")(icon.Props{Size: 16, Class: "mr-2 transition-transform group-hover:-translate-x-1"})
				Back to Recipes
			}
			@card.Card(card.Props{Class: "text-center py-12"}) {
				@card.Content() {
					<div class="text-destructive mb-6">
						@icon.Icon("triangle")(icon.Props{Size: 64, Class: "mx-auto"})
					</div>
					<h2 class="text-2xl font-bold text-foreground mb-4">Oops! Something went wrong</h2>
					<p class="text-muted-foreground mb-8 text-lg">{ errorMsg }</p>
					@button.Button(button.Props{Href: "/", Class: "group"}) {
						@icon.Icon("house")(icon.Props{Size: 16, Class: "mr-2"})
						Go Back to Recipes
					}
				}
			}
		</div>
	</div>
}

// Helper functions

func getRecipeTitle(recipe *models.Recipe) string {
	if recipe != nil {
		return recipe.Title
	}
	return "Recipe Not Found"
}

func formatIngredientName(ingredient models.Ingredient) string {
	return ingredient.Name
}

func hasIngredientQuantity(ingredient models.Ingredient) bool {
	return ingredient.Quantity > 0 || ingredient.Unit != ""
}

func formatQuantityNumber(quantity float32) string {
	if quantity == float32(int(quantity)) {
		return fmt.Sprintf("%.0f", quantity)
	}
	return fmt.Sprintf("%.1f", quantity)
}
