package pages

import (
	"github.com/AntonLuning/RecipeBank/internal/ui/components/input"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/modal"
)

templ BaseLayout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>{ title }</title>
			<link rel="stylesheet" href="/assets/css/output.css">
			<script defer src="https://cdn.jsdelivr.net/npm/@imacrayon/alpine-ajax@0.12.2/dist/cdn.min.js"></script>
			<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.1/dist/cdn.min.js"></script>
			@input.Script()
			@modal.Script()
		</head>
		<body class="bg-background text-foreground min-h-screen">
			<div class="container mx-auto px-4 py-8">
				{ children... }
			</div>
		</body>
	</html>
} 