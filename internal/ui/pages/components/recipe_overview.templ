package components


import (
	"net/url"
	"strconv"
	"strings"

	"github.com/AntonLuning/RecipeBank/pkg/models"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/badge"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/button"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/card"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/form"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/input"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/pagination"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/selectbox"
	"github.com/AntonLuning/RecipeBank/internal/ui/components/skeleton"
)

type RecipesGridData struct {
	RecipePage  *models.RecipePage
	Error       string
}

type FilterData struct {
	AvailableIngredients []string
	AvailableTags   	 []string
}

templ RecipesOverviewLoading() {
	<div id="recipes-overview" x-init="$ajax('/partial/recipes-overview')">
		@recipeFilters(&FilterData{})
		@recipeSkeletonGrid()
	</div>
}

templ RecipesOverview(filterData *FilterData, recipeData *RecipesGridData, filter *models.RecipeFilter) {
	<div id="recipes-overview">
		@recipeFilters(filterData)
		@RecipeGrid(recipeData, filter)
	</div>
}

templ RecipeGrid(data *RecipesGridData, filter *models.RecipeFilter) {
	<div id="recipes-grid">
		if data.Error != "" {
			@errorState(data.Error)
		} else {
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
				if len(data.RecipePage.Recipes) == 0 {
					<div class="col-span-full text-center py-8">
						<div class="text-muted-foreground mb-4">
							<svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
							</svg>
						</div>
						<p class="text-muted-foreground">No recipes found. Try adjusting your search criteria or start adding new recipes.</p>
					</div>
				} else {
					for _, recipe := range data.RecipePage.Recipes {
						@recipeCard(recipe)
					}
				}
			</div>
			if data.RecipePage != nil && data.RecipePage.TotalPages > 1 {
				@recipePagination(data.RecipePage, filter)
			}
		}
	</div>
}

templ recipeFilters(filter *FilterData) {
	@card.Card(card.Props{Class: "mb-8"}) {
		@card.Content() {
			<form method="GET" action="/partial/recipes" x-target="recipes-grid">
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
					@form.Item() {
						@form.Label(form.LabelProps{For: "title"}) {
							Recipe Title
						}
						@input.Input(input.Props{
							ID:          "title",
							Name:        "title",
							Type:        input.TypeText,
							Placeholder: "Search by title...",
						})
					}
					@form.Item() {
						@form.Label(form.LabelProps{For: "ingredient_names"}) {
							Ingredients
						}
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								ID:        "ingredient_names",
								Name:      "ingredient_names",
								ShowPills: true,
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Select ingredients...",
								})
							}
							@selectbox.Content() {
								for _, ingredient := range filter.AvailableIngredients {
									@selectbox.Item(selectbox.ItemProps{
										Value: strings.ToLower(ingredient),
									}) {
										{ ingredient }
									}
								}
							}
						}
					}
					@form.Item() {
						@form.Label(form.LabelProps{For: "cook_time"}) {
							Cook Time (min)
						}
						@input.Input(input.Props{
							ID:          "cook_time",
							Name:        "cook_time",
							Type:        input.TypeNumber,
							Placeholder: "e.g. 30",
						})
					}
					@form.Item() {
						@form.Label(form.LabelProps{For: "tags"}) {
							Tags
						}
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{
								ID:        "tags",
								Name:      "tags",
								ShowPills: true,
							}) {
								@selectbox.Value(selectbox.ValueProps{
									Placeholder: "Select tags...",
								})
							}
							@selectbox.Content() {
								for _, tag := range filter.AvailableTags {
									@selectbox.Item(selectbox.ItemProps{
										Value: strings.ToLower(tag),
									}) {
										{ tag }
									}
								}
							}
						}
					}
					<div class="flex items-end">
						@button.Button(button.Props{
							Type: "submit",
							Class: "w-full",
						}) {
							Search
						}
					</div>
				</div>
			</form>
		}
	}
}

templ recipeCard(recipe models.Recipe) {
	<a href={ templ.URL("/recipe/" + recipe.ID.Hex()) } class="block">
		@card.Card(card.Props{Class: "hover:shadow-lg transition-shadow duration-300 cursor-pointer"}) {
			<div class="aspect-w-16 aspect-h-9">
				<img 
					src={ GetRecipeImageSrc(recipe.Image) }
					alt={ recipe.Title }
					class="w-full h-48 object-cover rounded-t-lg"
					loading="lazy"
					onerror="this.onerror=null; this.src='data:image/svg+xml;base64,'"
				>
			</div>
			@card.Header() {
				@card.Title() {
					{ recipe.Title }
				}
				@card.Description() {
					<div class="h-[2.5rem] flex items-start overflow-hidden">
						if recipe.Description != "" {
							<p class="text-sm line-clamp-2 leading-tight">{ recipe.Description }</p>
						} else {
							<span class="text-muted-foreground italic text-sm">No description available</span>
						}
					</div>
				}
			}
			@card.Content(card.ContentProps{Class: "pt-0 pb-3"}) {
				<div class="flex items-center justify-between text-xs text-muted-foreground mb-4 min-h-[1.25rem]">
					<span class="flex items-center">
						if recipe.CookTime > 0 {
							<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							{ FormatCookTime(recipe.CookTime) }
						} else {
							<svg class="w-4 h-4 mr-1 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
							<span class="opacity-50">No time</span>
						}
					</span>
					<span class="flex items-center">
						if recipe.Servings > 0 {
							<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
							</svg>
							{ FormatServings(recipe.Servings) }
						} else {
							<svg class="w-4 h-4 mr-1 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
							</svg>
							<span class="opacity-50">No servings</span>
						}
					</span>
				</div>

				<div class="flex flex-nowrap gap-1.5 mb-2 min-h-[1.5rem] overflow-hidden">
					if len(recipe.Tags) > 0 {
						for i, tag := range recipe.Tags {
							if i < 3 {
								@badge.Badge(badge.Props{
									Variant: badge.VariantSecondary,
									Class:   "text-xs flex-shrink-0 max-w-[5rem] overflow-hidden",
									Attributes: templ.Attributes{
										"title": tag,
									},
								}) {
									<span class="truncate block">{ tag }</span>
								}
							}
						}
						if len(recipe.Tags) > 3 {
							@badge.Badge(badge.Props{
								Variant: badge.VariantSecondary,
								Class:   "text-xs opacity-75 flex-shrink-0",
							}) {
								+{ formatExtraTags(len(recipe.Tags) - 3) }
							}
						}
					} else {
						@badge.Badge(badge.Props{
							Variant: badge.VariantSecondary,
							Class:   "opacity-50 text-xs flex-shrink-0",
						}) {
							No tags
						}
					}
				</div>
			}
		}
	</a>
}

templ errorState(errorMsg string) {
	@card.Card(card.Props{Class: "text-center py-8"}) {
		@card.Content() {
			<div class="text-destructive mb-4">
				<svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
				</svg>
			</div>
			<p class="text-muted-foreground mb-4">{ errorMsg }</p>
			@button.Button(button.Props{Href: "/"}) {
				Try Again
			}
		}
	}
}

templ recipePagination(recipePage *models.RecipePage, filter *models.RecipeFilter) {
	@pagination.Pagination(pagination.Props{Class: "mt-8"}) {
		@pagination.Content() {
			if recipePage.Page > 1 {
				@pagination.Item() {
					@pagination.Previous(pagination.PreviousProps{
                        Href:  "/partial/recipes?" + buildPaginationQueryString(recipePage.Page - 1, filter),
                        Label: "Previous",
						Attributes: templ.Attributes{
							"x-target": "recipes-grid",
						},
                    })
				}
			}
			
			for i := 1; i <= recipePage.TotalPages; i++ {
				if i == recipePage.Page {
					@pagination.Item() {
						@pagination.Link(pagination.LinkProps{
							IsActive: true,
						}) {
							{ formatPageNumber(i) }
						}
					}
				} else if shouldShowPage(i, recipePage.Page, recipePage.TotalPages) {
					@pagination.Item() {
						@pagination.Link(pagination.LinkProps{
							Href: "/partial/recipes?" + buildPaginationQueryString(i, filter),
							Attributes: templ.Attributes{
								"x-target": "recipes-grid",
							},
						}) {
							{ formatPageNumber(i) }
						}
					}
				}
			}
			
			if recipePage.Page < recipePage.TotalPages {
				@pagination.Item() {
					@pagination.Next(pagination.NextProps{
						Href:  "/partial/recipes?" + buildPaginationQueryString(recipePage.Page + 1, filter),
						Label: "Next",
						Attributes: templ.Attributes{
							"x-target": "recipes-grid",
						},
					})
				}
			}
		}
	}
}

templ recipeSkeletonGrid() {
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
		for i := 0; i < 12; i++ {
			@recipeSkeletonCard()
		}
	</div>
}

templ recipeSkeletonCard() {
	@card.Card(card.Props{Class: "overflow-hidden border-0 shadow-none"}) {
		@skeleton.Skeleton(skeleton.Props{Class: "w-full h-48 rounded-none"})
		@card.Header() {
			@card.Title() {
				@skeleton.Skeleton(skeleton.Props{Class: "h-4 w-3/4"})
			}
			@card.Description() {
				<div class="h-[2.5rem] flex flex-col gap-2">
					@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-full"})
					@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-2/3"})
				</div>
			}
		}
		@card.Content(card.ContentProps{Class: "pt-0 pb-3"}) {
			<div class="flex items-center justify-between mb-4">
				@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-16"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-20"})
			</div>
			<div class="flex gap-1.5">
				@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-16 rounded-full"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-20 rounded-full"})
				@skeleton.Skeleton(skeleton.Props{Class: "h-5 w-12 rounded-full"})
			</div>
		}
	}
}

// Helper functions

func buildPaginationQueryString(page int, filter *models.RecipeFilter) string {
	params := url.Values{}
	params.Set("page", strconv.Itoa(page))

	// Add existing search parameters
	if filter.Title != "" {
		params.Set("title", filter.Title)
	}
	if len(filter.IngredientNames) > 0 {
		params.Set("ingredient_names", strings.Join(filter.IngredientNames, ","))
	}
	if filter.CookTime > 0 {
		params.Set("cook_time", strconv.Itoa(filter.CookTime))
	}
	if len(filter.Tags) > 0 {
		params.Set("tags", strings.Join(filter.Tags, ","))
	}

	return params.Encode()
}

func shouldShowPage(page, currentPage, totalPages int) bool {
	// Always show first and last page
	if page == 1 || page == totalPages {
		return true
	}

	// Show pages within 2 of current page
	if page >= currentPage-2 && page <= currentPage+2 {
		return true
	}

	return false
}

func getQueryValue(query map[string][]string, key string) string {
	if values, exists := query[key]; exists && len(values) > 0 {
		return values[0]
	}
	return ""
}

func formatExtraTags(count int) string {
	return strconv.Itoa(count)
}

func formatPageNumber(page int) string {
	return strconv.Itoa(page)
}
